# Required — copy this file to .env and fill in your values
# Never commit .env to version control

# IMAP credentials
IMAP_SERVER=mail.example.com
EMAIL_USER=you@example.com
EMAIL_PASS=your_password_here

# Folder names (adjust to match your mail server)
INBOX_FOLDER=INBOX
JUNK_FOLDER=Junk

# Ollama model (must be available via `ollama list`)
# Recommended: gemma2:2b — best binary classification, fastest, uses ~1.6 GB RAM
# Alternative: qwen2.5:3b — better multilingual quality (incl. Czech), ~2-3 GB RAM
MODEL_NAME=gemma2:2b

# ChromaDB path (relative to working directory)
DB_PATH=./spam_memory

# Tuning
MAX_JUNK_EMAILS=300   # how many recent junk emails to keep in memory
MAX_EMAIL_CHARS=1000  # max characters to read from each email body
SIMILAR_RESULTS=5     # how many spam examples to use for distance analysis

# Hybrid classifier thresholds (tuned for gemma2:2b on limited resources)
SPAM_DISTANCE_THRESHOLD=0.6   # avg ChromaDB distance below = confident SPAM
HAM_DISTANCE_THRESHOLD=0.4    # min distance threshold for confident decisions
CONFIDENCE_MARGIN=0.15        # margin between thresholds

# Pattern-based detection (enabled by default — disable if you prefer pure LLM)
ENABLE_SPAM_PATTERNS=true     # enable keyword/urgency pattern matching
SPAM_KEYWORD_WEIGHT=0.3       # weight for spam keyword matches
SPAM_URGENCY_WEIGHT=0.25      # weight for urgency language detection
SPAM_SENDER_WEIGHT=0.25       # weight for sender domain analysis
SPAM_STRUCTURE_WEIGHT=0.2     # weight for content structure anomalies

# Active learning: record misclassified emails for training feedback
ENABLE_ACTIVE_LEARNING=true
